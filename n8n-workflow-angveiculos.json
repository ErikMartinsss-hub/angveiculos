{
  "name": "Agente AngVeículos - WhatsApp + Gemini",
  "nodes": [
    {
      "id": "whatsapp-trigger",
      "name": "Receber Mensagem WhatsApp",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 300],
      "parameters": {
        "httpMethod": "POST",
        "path": "angveiculos-webhook",
        "options": {}
      },
      "webhookId": "angveiculos-webhook"
    },
    {
      "id": "extract-message",
      "name": "Extrair Texto",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [450, 300],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "userMessage",
              "value": "={{ $json.body.entry?.[0]?.changes?.[0]?.value?.messages?.[0]?.text?.body || $json.body.text?.body || $json.body.message }}",
              "type": "string"
            },
            {
              "name": "userPhone",
              "value": "={{ $json.body.entry?.[0]?.changes?.[0]?.value?.messages?.[0]?.from || $json.body.from || '' }}",
              "type": "string"
            },
            {
              "name": "userName",
              "value": "={{ $json.body.entry?.[0]?.changes?.[0]?.value?.contacts?.[0]?.profile?.name || $json.body.profileName || 'Cliente' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "gemini-model",
      "name": "Gemini Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [550, 500],
      "parameters": {
        "model": "gemini-2.0-flash",
        "options": {
          "temperature": 0.7
        }
      },
      "credentials": {
        "googleAiApi": {
          "id": "GOOGLE_AI_CREDENTIAL_ID",
          "name": "Google AI API"
        }
      }
    },
    {
      "id": "memory",
      "name": "Memory Buffer",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.3,
      "position": [750, 500],
      "parameters": {
        "sessionIdType": "customKey",
        "sessionKey": "={{ $json.userPhone }}",
        "contextWindowLength": 20
      }
    },
    {
      "id": "gemini-agent",
      "name": "Gemini - Responder",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [700, 300],
      "parameters": {
        "options": {
          "systemMessage": "Você é o atendente virtual da AngVeículos, uma agência de veículos seminovos. Responda de forma educada, acolhedora e profissional.\n\nINFORMAÇÕES DA EMPRESA:\n- Nome: Ang Veículos\n- Tipo: Agência de veículos seminovos (carros e motos)\n- Qualidade e procedência em cada veículo\n\nCONTATOS:\n- WhatsApp Anizio: (11) 94783-1797\n- WhatsApp Gabriel: (11) 94239-8993\n\nHORÁRIO:\n- Seg a Sex: 9h às 18h\n- Sábado: 9h às 13h\n\nREGRAS:\n- Se perguntarem sobre veículos disponíveis, peça para acessar o site e ver o estoque atualizado\n- Se perguntarem sobre preços, diga que os valores estão no site e que podem negociar com a equipe de vendas\n- Se for agendamento de visita, peça nome completo, telefone, qual veículo tem interesse e melhor horário. Depois confirme que a equipe entrará em contato\n- Se for proposta de venda (querer vender o veículo), passe o contato dos vendedores\n- Se não souber responder, transfira para atendente humano\n- NÃO invente informações sobre veículos específicos, estoque ou preços\n- Sempre use tom amigável e profissional\n\nQuando identificar que o cliente quer agendar visita ou falar com vendedor, direcione para um dos WhatsApps: (11) 94783-1797 (Anizio) ou (11) 94239-8993 (Gabriel)."
        }
      }
    },
    {
      "id": "check-response",
      "name": "Verificar Resposta",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [950, 300],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "rightValue": ""
          },
          "conditions": [
            {
              "id": "condition-1",
              "leftValue": "={{ $json.output?.toLowerCase() }}",
              "rightValue": "não sei responder",
              "operator": {
                "type": "string",
                "operation": "contains"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "whatsapp-send-ai",
      "name": "Enviar Resposta IA",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1200, 200],
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v19.0/{{ $credentials.whatsappBusinessApi.phoneNumberId }}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $credentials.whatsappBusinessApi.accessToken }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"to\": \"{{ $node['Extrair Texto'].json.userPhone }}\",\n  \"type\": \"text\",\n  \"text\": {\n    \"body\": \"{{ $json.output }}\"\n  }\n}"
      }
    },
    {
      "id": "notify-human",
      "name": "Notificar Humano",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1200, 450],
      "parameters": {
        "chatId": "={{ $credentials.telegramApi.chatId }}",
        "text": "🚨 *AngVeículos - IA não conseguiu responder*\n\n*Cliente:* {{ $node['Extrair Texto'].json.userName }}\n*Telefone:* {{ $node['Extrair Texto'].json.userPhone }}\n*Pergunta:* {{ $node['Extrair Texto'].json.userMessage }}\n\n*Resposta da IA:* {{ $node['Gemini - Responder'].json.output }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "credentials": {
        "telegramApi": {
          "id": "TELEGRAM_CREDENTIAL_ID",
          "name": "Telegram API"
        }
      }
    }
  ],
  "connections": {
    "Receber Mensagem WhatsApp": {
      "main": [
        [{ "node": "Extrair Texto", "type": "main", "index": 0 }]
      ]
    },
    "Extrair Texto": {
      "main": [
        [{ "node": "Gemini - Responder", "type": "main", "index": 0 }]
      ]
    },
    "Gemini Chat Model": {
      "ai_languageModel": [
        [{ "node": "Gemini - Responder", "type": "ai_languageModel", "index": 0 }]
      ]
    },
    "Memory Buffer": {
      "ai_memory": [
        [{ "node": "Gemini - Responder", "type": "ai_memory", "index": 0 }]
      ]
    },
    "Gemini - Responder": {
      "main": [
        [{ "node": "Verificar Resposta", "type": "main", "index": 0 }]
      ]
    },
    "Verificar Resposta": {
      "main": [
        [{ "node": "Enviar Resposta IA", "type": "main", "index": 0 }],
        [{ "node": "Notificar Humano", "type": "main", "index": 0 }]
      ]
    }
  },
  "pinData": {},
  "versionId": "2.0",
  "active": true,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": []
}
